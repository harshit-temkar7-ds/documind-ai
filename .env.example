LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=4096
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=200
CHUNK_OVERLAP=30
CHUNK_UNIT=tokens
TOP_K_RESULTS=5
ALLOWED_ORIGINS=http://localhost:8000
