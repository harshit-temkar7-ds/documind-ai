GROUNDING_OVERLAP_THRESHOLD=0.30
VECTOR_BACKEND=faiss
HYBRID_SEARCH=false
ENABLE_RERANK=false
ENABLE_FAITHFULNESS_CHECK=false
TORCH_THREADS=1
